fun map2(f) = case
  [a, ..rest, b] then 
    [f(a), ..map2(f)(rest), f(b)]
  [] then []

fun map2Eager(f) = case
  [a, ...rest, b] then 
    [f(a), ...map2Eager(f)(rest), f(b)]
  [] then []

