:sjs
fun buildLazy(i) =
  if i > 0 then [i, ..buildLazy(i - 1), -i] else []
//│ JS (unsanitized):
//│ let buildLazy;
//│ buildLazy = function buildLazy(i) {
//│   let scrut1, tmp9, tmp10, tmp11;
//│   scrut1 = i > 0;
//│   if (scrut1 === true) {
//│     tmp9 = i - 1;
//│     tmp10 = buildLazy(tmp9);
//│     tmp11 = - i;
//│     return runtime.Tuple.lazyConcat(i, runtime.Tuple.split, tmp10, tmp11)
//│   } else {
//│     return []
//│   }
//│ };

:sjs
fun buildEager(i) =
  if i > 0 then [i, ...buildEager(i - 1), -i] else []
//│ JS (unsanitized):
//│ let buildEager;
//│ buildEager = function buildEager(i) {
//│   let scrut1, tmp9, tmp10, tmp11;
//│   scrut1 = i > 0;
//│   if (scrut1 === true) {
//│     tmp9 = i - 1;
//│     tmp10 = buildEager(tmp9);
//│     tmp11 = - i;
//│     return [
//│       i,
//│       ...tmp10,
//│       tmp11
//│     ]
//│   } else {
//│     return []
//│   }
//│ };

