
import "./Iter.mls"
import "./FingerTreeList.mls"

open Iter
open FingerTreeList
open LazyArrayOld

val useLFT = false

class LazyItr extends IterableBase with
  fun toString() = "[" + this joined(", ") + "]"

// * A View is what we get when we match patterns of the form [x, ..xs]
// FIXME: `underlying` should be understood as an efficiently random-accessible thing
class View(val underlying: IterableBase, val start, val end) extends LazyItr with
  fun iterator() = 
    let uitr = underlying.(Symbol.iterator)()
    let idx = 0
    let until = underlying.length - end
    Iterator of () =>
      while idx < start do
        uitr.next()
        set idx = idx + 1
      if idx < until then
        set idx = idx + 1
        let next = uitr.next()
        if next.done then Result.Done
        else Result.Next of next.value
      else Result.Done

  fun flatten() = 
    LazyArrayOld.flatten(underlying) FingerTreeList.slice(start, end)()

  fun length = underlying.length - start - end
  fun toString() = "[" + this joined(", ") + "]"

// * [A, B, ..C, D, ..E, F] is represented as Splice([A, B, SpliceMarker, C, D, SpliceMarker, E, F])
object SpliceMarker
class Splice(val bits) extends LazyItr with
  fun iterator() =
    let uitr = null
    let subiter = false
    let idx = 0
    fun nextf() =
      if idx < bits.length and
        bits.[idx] is
          SpliceMarker then
            if subiter == false then 
              set subiter = true
              set uitr = bits.[idx + 1].(Symbol.iterator)()
            else ()
            let n = uitr.next()
            if n.done then
              set subiter = false
              set idx = idx + 2
              nextf()
            else
              n
          else
            let value = bits.[idx]
            set idx = idx + 1
            Result.Next of value
      else Result.Done
    Iterator of nextf

  let lengthHelper =
    val go = case
      [SpliceMarker, e, ...rest] then e.length + go(rest)
      [a, ...rest] then 1 + go(rest)
      [] then 0
    go

  let flattenHelper =
    val go = case
      [SpliceMarker, e, ..rest] then LazyArrayOld.flatten(e) ++ go(rest)
      [a, ...rest] then FingerTreeList.mk(a) ++ go(rest)
      [] then []
    go

  fun flatten() = 
    flattenHelper(bits)

  fun length = lengthHelper(bits)
  fun toString() = "[" + this joined(", ") + "]"

fun normIdx(idx, len) =
  if idx < 0 then idx + len
  else idx

class LazyItrBoxed(val underlying: IterableBase) extends IterableBase with
  mut val fuse = 5

  fun iterator() = underlying.(Symbol.iterator)()

  fun updateFlatten() = 
    if fuse > 0 then
      set fuse -=  1
    else
      set underlying = LazyArrayOld.flatten(underlying)

  fun length = underlying.length
  // TODO: fix to not traverse one by one
  fun at(idx) =
    if underlying is
      Array then ()
      else updateFlatten()
    if underlying is
      LazyItr then
        let itr = underlying.(Symbol.iterator)()
        let next = itr.next()
        set idx = normIdx(idx, underlying.length)
        while idx > 0 do
          set idx = idx - 1
          set next = itr.next()
          if next.done then throw "at: index out of bounds"
          else ()
        next.value
      else underlying.at(idx)

  fun concat(...args) = LazyArrayOld.concat(split, underlying, ...(args.flatMap(x => [split, x])))
  fun slice(beg, end) = LazyArrayOld.slice(beg, underlying.length - end)(underlying)
  fun toString() = "[" + this joined(", ") + "]"

fun unbox = if useLFT 
  then
    case
      LazyItrBoxed(underlying) then underlying
      Array | IterableBase as itr then FingerTreeList.safeInput(itr)
      x then x
  else
    case
      LazyItrBoxed(underlying) then underlying
      x then x

fun safeArgs(args) = if args is
  [SpliceMarker, itr, ...rest] then
    [SpliceMarker, unbox(itr), ...safeArgs(rest)]
  [x, ...rest] then [x, ...safeArgs(rest)]
  [] then []


module LazyArrayOld with...


fun flatten(xs) = if 
  useLFT and 
    xs is
      LazyItr then xs.flatten()
      x then x
  else [...xs]

fun mk(...args) = LazyItrBoxed of 
  if useLFT 
  then FingerTreeList.safeInput(args) 
  else args

fun concat(...args) = LazyItrBoxed of Splice(safeArgs(args))

fun slice(beg, end)(itr) = 
  let itr = if unbox(itr) is
    View(itr, beg', end') as v and beg + end <= v.length
      then
        View(itr, beg' + beg, end' + end)
    _ as itr and beg + end <= itr.length
      then View(itr, beg, end)
    else throw "slice: index out of bounds"
  LazyItrBoxed of itr

val split = SpliceMarker
