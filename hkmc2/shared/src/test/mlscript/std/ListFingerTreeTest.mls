//│   if (scrut === true) {
//│     return acc
//│   } else {
//│     tmp43 = start + 1;
//│     tmp44 = runtime.safeCall(lft.at(start));
//│     return popByIndex(tmp43, end, runtime.Tuple.lazyConcat(runtime.Tuple.split, acc,
//│     tmp44), lft)
//│   }
//│ };

