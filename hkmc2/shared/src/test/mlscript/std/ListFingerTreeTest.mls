fun map(f) = case
  [a, ..rest] then
    [f(a), ..map(f)(rest)]
  [] then []

fun mapEager(f) = case
  [a, ...rest] then
    [f(a), ...mapEager(f)(rest)]
  [] then []

:silent
let res = buildEager(1000)

:silent
:clock 1
let lm = map(x => x + 1)(res)
//+ runtime clock time (1): 4.127789 ms

:silent
:clock 1
mapEager(x => x + 1)(res)
//+ runtime clock time (1): 32.002158 ms

fun silly = case
  [a, b, ..xs] then [..xs, ..silly([a, ..xs])]
  [a, ..xs] then [a, ..silly(xs)]
  [] then []

fun sillyEager = case
  [a, b, ...xs] then [...xs, ...sillyEager([a, ...xs])]
  [a, ...xs] then [a, ...sillyEager(xs)]
  [] then []

:clock 9
:silent
let xs = buildEager(150)
//+ runtime clock time (9): 0.405445 ms

:clock 9
:silent
silly(xs)
//+ runtime clock time (9): 1.460545 ms

:clock 9
:silent
sillyEager(xs)
//+ runtime clock time (9): 68.560182 ms

:clock 9
:silent
[...silly(xs)]
//+ runtime clock time (9): 1.083494 ms
