//│     rest1 = runtime.safeCall(runtime.Tuple.lazySlice(xs2, 1, 1));
//│     last0 = runtime.Tuple.get(xs2, -1);
//│     a1 = first01;
//│     ls1 = rest1;
//│     b = last0;
//│     tmp38 = funnySum(ls1);
//│     tmp39 = a1 + tmp38;
//│     return tmp39 - b
