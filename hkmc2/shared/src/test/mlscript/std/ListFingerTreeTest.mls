:js
// :de
// :sjs
// :pt
// :elt

import "../../mlscript-compile/ListFingerTree.mls"

open ListFingerTree

let xs = ListFingerTree.mk(1,2,3)
//│ xs = [1, 2, 3]


let ys = concat(xs, xs) concat(xs)
//│ ys = [1, 2, 3, 1, 2, 3, 1, 2, 3]

ys |> ith(-1)
//│ = None
ys |> ith(0)
//│ = Some(1)
ys |> ith(1)
//│ = Some(2)
ys |> ith(2)
//│ = Some(3)
ys |> ith(3)
//│ = Some(1)
ys |> ith(4)
//│ = Some(2)
ys |> ith(5)
//│ = Some(3)
ys |> ith(6)
//│ = Some(1)
ys |> ith(7)
//│ = Some(2)
ys |> ith(8)
//│ = Some(3)
ys |> ith(9)
//│ = None

let ys = (ys |> popFront).rest
//│ ys = [2, 3, 1, 2, 3, 1, 2, 3]
let ys = (ys |> popBack).rest
//│ ys = [2, 3, 1, 2, 3, 1, 2]
let ys = (ys |> popBack).rest
//│ ys = [2, 3, 1, 2, 3, 1]
let ys = (ys |> popBack).rest
//│ ys = [2, 3, 1, 2, 3]
let ys = (ys |> popFront).rest
//│ ys = [3, 1, 2, 3]
let ys = (ys |> popFront).rest
//│ ys = [1, 2, 3]
let ys = (ys |> popFront).rest
//│ ys = [2, 3]

let ys = concat(concat(xs, xs), xs)
//│ ys = [1, 2, 3, 1, 2, 3, 1, 2, 3]

// TODO: implement & test slice
ys |> slice(3, 3)
//│ = [1, 2, 3]

:sjs
[...[1, 2, 3]]
//│ JS (unsanitized):
//│ [ ...[ 1, 2, 3 ] ]
//│ = [1, 2, 3]

let ys = 1 +: 2 +: 3 +: ys :+ 1 :+ 2 :+ 3
//│ ys = [1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3]

[...ys]
//│ = [1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3]

ListFingerTree.length(ys ++ ys)
//│ = 30

ys
//│ = [1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3]


let zs = ys ++ ys
//│ zs = [1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3]

[...zs]
//│ = [1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3]

[...zs] Array.isArray()
//│ = true

fun mkRange(start, end) =
  if start < end then
    mkRange(start + 1, end) :+ start
  else
    mk()

fun repeat(xs, n) = 
  if n == 0 then mk()
  else xs ++ repeat(xs, n - 1)

xs ++ xs
//│ = [1, 2, 3, 1, 2, 3]

1
//│ = 1

// TODO: 
repeat(xs, 512).length
//│ = 1536

mk(1, 2, 3).length
//│ = 3

mk(1, 2, 3).at(2)
//│ = 3


// Lazy spread syntax
let xs = ListFingerTree.mk(1, 2, 3)
//│ xs = [1, 2, 3]

xs |> ith(1)
//│ = Some(2)

// Note: this is still eager
[0, ..xs]
//│ = [0, 1, 2, 3]

// Note: ls is a finger tree
if xs is
  [a, ..ls] then [a, ls]
//│ = [1, [2, 3]]

:sjs
fun buildLazy(i) =
  if i > 0 then [i, ..buildLazy(i - 1), -i] else []
//│ JS (unsanitized):
//│ let buildLazy;
//│ buildLazy = function buildLazy(i) {
//│   let scrut, tmp38, tmp39, tmp40;
//│   scrut = i > 0;
//│   if (scrut === true) {
//│     tmp38 = i - 1;
//│     tmp39 = buildLazy(tmp38);
//│     tmp40 = - i;
//│     return runtime.Tuple.lazyConcat(i,
//│     runtime.Tuple.split, tmp39,
//│     tmp40)
//│   } else {
//│     return []
//│   }
//│ };

:sjs
fun buildEager(i) =
  if i > 0 then [i, ...buildEager(i - 1), -i] else []
//│ JS (unsanitized):
//│ let buildEager;
//│ buildEager = function buildEager(i) {
//│   let scrut, tmp38, tmp39, tmp40;
//│   scrut = i > 0;
//│   if (scrut === true) {
//│     tmp38 = i - 1;
//│     tmp39 = buildEager(tmp38);
//│     tmp40 = - i;
//│     return [
//│       i,
//│       ...tmp39,
//│       tmp40
//│     ]
//│   } else {
//│     return []
//│   }
//│ };

:sjs
fun funnySum(xs) = if xs is
  [a, ..ls, b] then
    a + funnySum(ls) - b
  [] then 0
