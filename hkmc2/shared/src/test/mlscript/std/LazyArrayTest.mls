:e
fun what(..args) = args
//│ ╔══[ERROR] Lazy spread parameters not allowed.
//│ ║  l.354: 	fun what(..args) = args
//│ ╙──       	           ^^^^

fun silly = case
  [a, b, ..xs] then [..xs, ..silly([a, ..xs])]
  [a, ..xs] then [a, ..silly(xs)]
  [] then []

fun sillyEager = case
  [a, b, ...xs] then [...xs, ...sillyEager([a, ...xs])]
  [a, ...xs] then [a, ...sillyEager(xs)]
  [] then []

:clock 3c9984c
:silent
let xs = buildEager(150)
//+ runtime clock time (3c9984c): 0.627603 ms

:clock 3c9984c
:silent
let ys = silly(xs)
//+ runtime clock time (3c9984c): 5.636836 ms

// materializes
:clock 3c9984c
ys.at(0)
//+ runtime clock time (3c9984c): 66.970539 ms
//│ = 148

:clock 3c9984c
:silent
sillyEager(xs)
//+ runtime clock time (3c9984c): 82.238481 ms
