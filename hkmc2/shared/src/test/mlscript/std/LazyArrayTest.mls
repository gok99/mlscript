:expect true
:silent
buildLazy(2).concat([11, 12, 13], LazyArray.mk(2, 4, 6, 8, 10)) |> isArrayLike

:sjs
fun map(f) = case
  [a, ..rest] then
    [f(a), ..map(f)(rest)]
  [] then []
//│ JS (unsanitized):
//│ let map;
//│ map = function map(f) {
//│   let lambda;
//│   lambda = (undefined, function (caseScrut) {
//│     let rest2, first02, a2, rest3, tmp14, tmp15, tmp16;
//│     if (runtime.Tuple.isArrayLike(caseScrut) && caseScrut.length >= 1) {
//│       first02 = caseScrut.at(0);
//│       rest2 = runtime.safeCall(runtime.Tuple.lazySlice(caseScrut, 1, 0));
//│       a2 = first02;
//│       rest3 = rest2;
//│       tmp14 = runtime.safeCall(f(a2));
//│       tmp15 = map(f);
//│       tmp16 = runtime.safeCall(tmp15(rest3));
//│       return runtime.Tuple.lazyConcat(tmp14, runtime.Tuple.split, tmp16)
//│     } else if (runtime.Tuple.isArrayLike(caseScrut) && caseScrut.length === 0) {
//│       return []
//│     } else {
//│       throw new globalThis.Error("match error");
//│     }
//│   });
//│   return lambda
//│ };

:sjs
fun mapEager(f) = case
  [a, ...rest] then
    [f(a), ...mapEager(f)(rest)]
  [] then []
//│ JS (unsanitized):
//│ let mapEager;
//│ mapEager = function mapEager(f) {
//│   let lambda;
//│   lambda = (undefined, function (caseScrut) {
//│     let rest2, first02, a2, rest3, tmp14, tmp15, tmp16;
//│     if (runtime.Tuple.isArrayLike(caseScrut) && caseScrut.length >= 1) {
//│       first02 = caseScrut.at(0);
//│       rest2 = runtime.safeCall(runtime.Tuple.slice(caseScrut, 1, 0));
//│       a2 = first02;
//│       rest3 = rest2;
//│       tmp14 = runtime.safeCall(f(a2));
//│       tmp15 = mapEager(f);
//│       tmp16 = runtime.safeCall(tmp15(rest3));
//│       return [
//│         tmp14,
//│         ...tmp16
//│       ]
//│     } else if (runtime.Tuple.isArrayLike(caseScrut) && caseScrut.length === 0) {
//│       return []
//│     } else {
//│       throw new globalThis.Error("match error");
//│     }
//│   });
//│   return lambda
//│ };

:silent
let res = buildEager(1000)

:silent
:clock 3c99841
let lm = map(x => x + 1)(res)
//+ runtime clock time (3c99841): 2.302105 ms

// materializes
:clock 3c9984c
lm.at(0)
//+ runtime clock time (3c9984c): 24.088312 ms
//│ = 1001

:silent
:clock 3c9984c
mapEager(x => x + 1)(res)
//+ runtime clock time (3c9984c): 31.039543 ms

:ge
mapEager(..[[1]])
//│ ╔══[COMPILATION ERROR] Lazy spreads are not supported in call arguments
//│ ║  l.347: 	mapEager(..[[1]])
//│ ╙──       	        ^^^^^^^^^
