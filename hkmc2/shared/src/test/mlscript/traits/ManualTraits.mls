trait Foo with
  fun foo: Int
  fun boo() = foo * 10
//│ JS (unsanitized):
//│ let Foo1;
//│ Foo1 = function Foo(Impl) {
//│   let Foo2;
//│   Foo2 = class Foo extends Impl {
//│     static {
//│       Foo2 = Foo;
//│     }
//│     static boo() {
//│       return Foo.foo * 10
//│     }
//│     static toString() { return "Foo"; }
//│   };
//│   return Foo2
//│ };

object Bar with
  require Foo
  implement Foo with
    val foo = 1
  fun bar() = Foo.boo()

Bar.bar()
//│ = 10

object Bar with
  require Foo
  implement Foo with
    val foo = 1
  fun bar() = Bar.Foo.boo()

Bar.bar()
//│ = 10

