trait Foo with
  val foo: Int
  fun loo: Int
  fun boo() = foo * 10
  val too = loo

trait Bar with
  require Foo
  fun bar() = Foo.boo()

trait Bar2 with
  require Foo
  fun bar() = Foo.boo() + 1

