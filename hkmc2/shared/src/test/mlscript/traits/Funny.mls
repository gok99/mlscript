:js

trait T with
  fun foo = id

:rt
trait A1 with
  T.foo(1)
//│ Resolved tree:
//│ Blk:
//│   stats = Ls of 
//│     TraitDef:
//│       sym = trait:A1
//│       bsym = member:A1
//│       tparams = Nil
//│       paramsOpt = N
//│       auxParams = Nil
//│       body = ObjBody of Blk:
//│         stats = Nil
//│         res = App:
//│           lhs = Sel{member:foo}:
//│             prefix = Ref{member:T} of member:T
//│             nme = Ident of "foo"
//│           rhs = Tup of Ls of 
//│             Fld:
//│               flags = ()
//│               term = Lit of IntLit of 1
//│               asc = N
//│       kind = Trt
//│       annotations = Nil
//│       trt = Ref{trait:A1} of trait:A1
//│   res = Lit of UnitLit of false

