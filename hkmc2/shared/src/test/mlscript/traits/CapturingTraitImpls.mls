trait D with
  val doo: Int

trait C with
  require D
  require A
  implement D with
    val doo = 123
  implement A with
    val foo = 3
    val baz = D.doo + 1

object D with
  require C
  print(C.D.doo)
  print(C.A.foo)
  print(C.A.baz)
//│ > 123
//│ > 3
//│ > 124


