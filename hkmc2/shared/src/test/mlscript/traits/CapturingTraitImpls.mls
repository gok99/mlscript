:js


:sjs
trait A with
  fun foo: Int
//│ JS (unsanitized):
//│ let A1;
//│ A1 = function A(Impl) {
//│   let A2;
//│   A2 = class A extends Impl {
//│     static {
//│       A2 = A;
//│     }
//│     static toString() { return runtime.render(this); }
//│     static [definitionMetadata] = ["trait", "A"]; 
//│   };
//│   return A2
//│ };


trait B with
  require A
  val bar = A.foo + 1


:e
trait C with
  require B
  require A
  implement A with
    val foo = 3
    val baz = B.bar
//│ ╔══[ERROR] Implementation has an implicit requirement on B, but B (transitively) depends on trait A
//│ ║  l.32: 	    val foo = 3
//│ ║        	              ^
//│ ║  l.33: 	    val baz = B.bar
//│ ╙──      	^^^^^^^^^^^^^^^^^^^


trait D with
  mut val doo = 1

:sjs
trait C with
  require D
  require A
  implement A with
    fun foo = D.doo
    set D.doo += 1
