//│     static tootoo() {
//│       return Baz.Bar.Foo.too + Baz.Bar2.Foo.too
//│     }
//│     static toString() { return "Baz"; }
//│   };
//│   return Baz2
//│ };
//│ $imp$Bar$Foo1 = function $imp$Bar$Foo(Impl) {
