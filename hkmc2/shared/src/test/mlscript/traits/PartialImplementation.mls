:js

trait Foo with
  val foo: Int
  fun loo: Int
  fun boo() = foo * 10
  val too = loo

trait Bar with
  require Foo
  implement Foo with
    val foo = 1
  fun bar() = Foo.boo()

trait Bar2 with
  require Foo
  implement Foo with
    val foo = 1
  fun bar() = Foo.boo() + 1

trait Baz with
  require Bar
  require Bar2
  implement Bar.Foo with
    fun loo = 3
  fun tootoo() = Bar.Foo.too + Bar2.Foo.too

class Test with
  require Baz
  implement Foo with
    fun loo = 2
  val a = Baz.tootoo()

new Test().a
//│ = 5

