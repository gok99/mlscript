:js

//  :dl
:sjs
trait Foo with
  val foo: Int
  fun loo: Int
  fun boo() = foo * 10
  val too = loo
  print(foo)
  val foo2: Int = 1
//│ JS (unsanitized):
//│ let Foo1;
//│ Foo1 = function Foo(Impl) {
//│   let Foo2;
//│   Foo2 = class Foo extends Impl {
//│     static {
//│       Foo2 = Foo;
//│       let tmp;
//│       this.too = Foo.loo;
//│       tmp = Predef.print(Foo.foo);
//│       this.foo2 = 1;
//│     }
//│     static boo() {
//│       return Foo.foo * 10
//│     }
//│     static toString() { return "Foo"; }
//│   };
//│   return Foo2
//│ };

trait Bar with
  require Foo
  implement Foo with
    val foo = 1
  fun bar() = Foo.boo()

:sjs
trait Bar2 with
  require Foo
  implement Foo with
    val foo = 1
  fun bar() = Foo.boo() + 1
//│ JS (unsanitized):
//│ let Bar21, $imp$Foo3;
//│ Bar21 = function Bar2(Impl, Foo2) {
//│   let Bar22;
//│   Bar22 = class Bar2 extends Impl {
//│     static {
//│       Bar22 = Bar2;
//│       Bar22.Foo = Foo2;
//│     }
//│     static bar() {
//│       let tmp;
//│       tmp = Bar2.Foo.boo();
//│       return tmp + 1
//│     }
//│     static toString() { return "Bar2"; }
//│   };
//│   return Bar22
//│ };
//│ $imp$Foo3 = function $imp$Foo(Impl) {
//│   let $imp$Foo4;
//│   $imp$Foo4 = class $imp$Foo2 extends Impl {
//│     static {
//│       $imp$Foo4 = $imp$Foo2;
//│       this.foo = 1;
//│     }
//│     static toString() { return "$imp$Foo"; }
//│   };
//│   return $imp$Foo4
//│ };

:sjs
trait Baz with
  require Bar
  require Bar2
  implement Bar.Foo with
    fun loo = 3
  fun tootoo() = Bar.Foo.too + Bar2.Foo.too
//│ JS (unsanitized):
//│ let Baz1, $imp$Bar$Foo1;
//│ Baz1 = function Baz(Impl, Bar3, Bar22) {
