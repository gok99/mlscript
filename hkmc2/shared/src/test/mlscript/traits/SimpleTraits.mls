:js


// :dl
trait Foo with
  fun foo: Int
  fun boo() = foo * 10

class Bar with
  require Foo
  implement Foo with
    val foo = 1
  fun bar() = this.Foo.boo()
  fun bar2() = Foo.boo()
new Bar().bar()
//│ = 10

new Bar().bar2()
//│ = 10

trait Lol with
  val elem: Int

class Bar with
  require Foo
  require Lol
  val bar = 123
  implement Lol with
    val elem = 1
  implement Foo with
    val ok = "ok"
    fun foo = Lol.elem
new Bar().Foo.foo
//│ = 1

