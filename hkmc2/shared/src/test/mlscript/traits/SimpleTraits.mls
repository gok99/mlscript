// :dl
:sjs
trait Foo with
  fun foo: Int
  fun boo() = foo * 10
//│ JS (unsanitized):
//│ let Foo1;
//│ Foo1 = function Foo(Impl) {
//│   let Foo2;
//│   Foo2 = class Foo extends Impl {
//│     static {
//│       Foo2 = Foo;
//│     }
//│     static boo() {
//│       return Foo.foo * 10
//│     }
//│     static toString() { return runtime.render(this); }
//│     static [definitionMetadata] = ["trait", "Foo"]; 
//│   };
//│   return Foo2
//│ };

class Bar with
  require Foo
  implement Foo with
    val foo = 1
  fun bar() = this.Foo.boo()
  fun bar2() = Foo.boo()
new Bar().bar()
//│ = 10

new Bar().bar2()
//│ = 10

